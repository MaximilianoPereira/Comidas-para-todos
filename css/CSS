/* VARIABLES */
:root{
    --fondo: #121212;
    --fondo-secundario: #1f1f1f;
    --principal: #ee7631;
    --hover: #ff9a62;
    --texto: white;
    --texto-secundario: #d1d1d1;
    --fuente: Arial, sans-serif;
}

/* RESET */
*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* BODY */
body{
    background-color: var(--fondo);
    color: var(--texto);
    font-family: var(--fuente);
    line-height: 1.6;
}

/* NAVBAR */
nav ul{
    list-style: none;
    display: flex;
    flex-wrap: wrap;
}

nav ul li{
    flex: 1 1 200px;
}

nav ul li a{
    display: flex;
    justify-content: center;
    align-items: center;
    height: 60px;
    background-color: var(--principal);
    color: white;
    text-decoration: none;
    font-weight: bold;
    transition: background-color 0.3s;
}

nav ul li a:hover{
    background-color: var(--hover);
}

/* HEADER */
header{
    text-align: center;
}

header h2{
    margin-top: 30px;
    font-size: 2rem;
}

header p{
    width: 90%;
    max-width: 900px;
    margin: 20px auto;
    color: var(--texto-secundario);
}

/* LINKS DE CONTACTO */
header ul{
    list-style: none;
    margin-top: 20px;
}

header ul li{
    margin: 15px 0;
}

header ul li a{
    color: var(--principal);
    text-decoration: none;
    font-weight: bold;
}

header ul li a:hover{
    text-decoration: underline;
}

/* MAIN */
main{
    width: 90%;
    max-width: 1000px;
    margin: 40px auto;
    background-color: var(--fondo-secundario);
    padding: 30px;
    border-radius: 10px;
}

/* TITULOS */
h3{
    text-align: center;
    margin-bottom: 20px;
    font-size: 1.8rem;
}

/* PARRAFOS */
main p{
    text-align: center;
    margin-bottom: 25px;
}

/* FORMULARIO */
form{
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
}

/* LABELS */
form label{
    font-weight: bold;
}

/* INPUTS */
form input{
    width: 100%;
    max-width: 350px;
    height: 45px;
    border: none;
    border-radius: 8px;
    padding: 10px;
    font-size: 1rem;
}

/* BOTON */
form input[type="submit"]{
    width: 180px;
    background-color: var(--principal);
    color: white;
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.3s;
}

form input[type="submit"]:hover{
    background-color: var(--hover);
}

/* FOOTER */
footer{
    background-color: var(--principal);
    text-align: center;
    padding: 30px 20px;
    margin-top: 40px;
}

footer h2{
    margin-bottom: 15px;
}

footer p{
    margin-bottom: 20px;
}

footer a{
    color: #ffe082;
    text-decoration: none;
    font-weight: bold;
}

footer a:hover{
    text-decoration: underline;
}

/* RESPONSIVE */
@media(max-width: 600px){

    nav ul li a{
        height: 50px;
        font-size: 0.9rem;
    }

    header h2,
    h3{
        font-size: 1.5rem;
    }

    main{
        padding: 20px;
    }
}